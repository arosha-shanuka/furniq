# ============================================================
# SECURITY: Secrets & Keys — NEVER commit these
# ============================================================

# Firebase Service Account Key (FULL ADMIN ACCESS)
functions/serviceAccountKey.json
**/serviceAccountKey*.json

# Environment files with secrets
.env
.env.*
!.env.example
functions/.env
functions/.env.*
!functions/.env.example

# Stripe secrets (extra safety catch)
**/stripe_secret*
**/secret_key*

# Google Services config (contains Firebase API key)
**/google-services.json
**/GoogleService-Info.plist
lib/firebase_options.dart

# ============================================================
# Firebase Cloud Functions
# ============================================================
functions/node_modules/
functions/.runtimeconfig.json

# ============================================================
# Flutter / Dart
# ============================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id

# ============================================================
# IDE
# ============================================================
*.iml
*.ipr
*.iws
.idea/
.vscode/

# ============================================================
# Android build artifacts
# ============================================================
/android/app/debug
/android/app/profile
/android/app/release
**/android/**/gradle-wrapper.jar
.gradle/
local.properties

# ============================================================
# Unity build output (embedded in Android)
# ============================================================
/android/unityLibrary/libs/*.jar
/android/unityLibrary/src/main/il2cppOutputProject/

# ============================================================
# OS & Misc
# ============================================================
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
Thumbs.db

# ============================================================
# Symbolication & Obfuscation
# ============================================================
app.*.symbols
app.*.map.json

# ============================================================
# Report & diagram reference files (not source code)
# ============================================================
/report/
