# ============================================================
# Furniq Firebase Cloud Functions — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to Git!
# ============================================================

# Stripe Secret Key (get from https://dashboard.stripe.com/test/apikeys)
# For production, use Firebase Secret Manager instead:
#   echo YOUR_KEY | firebase functions:secrets:set STRIPE_SECRET_KEY --project YOUR_PROJECT --force
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE

# Stripe Publishable Key (set in lib/main.dart, not used by Cloud Functions)
# STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
